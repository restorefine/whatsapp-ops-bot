# Server
DOMAIN=bot.example.com
TZ=Europe/London
TZ_LABEL=UK
# Shown next to every time, e.g. "09:24 UK · 14:09 Nepal". "off" hides it.
SECOND_TZ=Asia/Kathmandu
SECOND_TZ_LABEL=Nepal
LOG_LEVEL=info

# WhatsApp Cloud API
WA_GRAPH_VERSION=v25.0
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Who may use the bot: name=number, digits only with country code, no plus,
# comma-separated. Each name must match one ClickUp member, as /<name> does.
# Admins (founders and project manager) can use every command. A bare number
# is allowed for an admin with no tasks in ClickUp.
ADMIN_WA_NUMBERS=
# Team members can only see and complete their own tasks (my tasks, done,
# undo) and /remind can message them. A number may appear in only one list.
TEAM_WA_NUMBERS=
# Older setting, still read: these numbers are admins without a name.
# OWNER_WA_NUMBER=
# Local development only: log replies instead of sending them.
WA_DRY_RUN=false

# ClickUp
CLICKUP_TOKEN=
CLICKUP_TEAM_ID=
# ClickUp folder holding the social media posting calendar (shown by /uploads). "none" disables.
UPLOADS_FOLDER=Uploads

# Metricool (read-only): posting schedule and whether posts went out.
# API token: Metricool > Account settings > API (REST API token). User ID: the number after userId=
# in Metricool's web address. Brand IDs are looked up automatically.
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
# ClickUp Uploads list → Metricool brand, only where the names differ.
# Spaces and capitals are ignored, so write names without spaces.
METRICOOL_BRANDS=ChocSpot=ChocStop,d2dAlloway=day.today.alloway
# Clients posted by hand: the posting checks use the ClickUp tick for these.
UPLOADS_MANUAL=FavSpot,Mannis,Damasqino
# Automatic posting summaries to admins (UK time): the first is the morning one,
# any others are midday ones. "off" disables.
POSTING_TIMES=08:00,12:00
# By when each client must post (UK time); "*" is every other client. The bot
# checks 15 minutes after each deadline whether the posts went out.
POSTING_DEADLINES=failte=07:00,*=17:00

# Daily reminder to every owner: work and posts due today and tomorrow.
# 24 hour HH:MM in TZ, or "off".
REMINDER_TIME=off
# Approved Meta template sent instead when an owner hasn't messaged the bot in
# the last 24 hours. Body variables: {{1}} due today, {{2}} due tomorrow.
# Leave empty to skip owners whose window is closed.
REMINDER_TEMPLATE=
REMINDER_TEMPLATE_LANG=en
