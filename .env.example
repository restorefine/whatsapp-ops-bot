# Server
DOMAIN=bot.example.com
TZ=Europe/London
LOG_LEVEL=info

# WhatsApp Cloud API
WA_GRAPH_VERSION=v25.0
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Numbers allowed to use the bot: digits only, with country code, no plus.
# Comma-separate several, e.g. 9779812345678,447700900123
OWNER_WA_NUMBER=
# Team members /remind can message: name=number, comma-separated, e.g.
# sunil=447700900123,himal=9779812345678. Each name must match one ClickUp member.
TEAM_WA_NUMBERS=
# Local development only: log replies instead of sending them.
WA_DRY_RUN=false

# ClickUp
CLICKUP_TOKEN=
CLICKUP_TEAM_ID=
# ClickUp folder holding the social media posting calendar (shown by /uploads). "none" disables.
UPLOADS_FOLDER=Uploads

# Daily reminder to every owner: work and posts due today and tomorrow.
# 24 hour HH:MM in TZ, or "off".
REMINDER_TIME=off
# Approved Meta template sent instead when an owner hasn't messaged the bot in
# the last 24 hours. Body variables: {{1}} due today, {{2}} due tomorrow.
# Leave empty to skip owners whose window is closed.
REMINDER_TEMPLATE=
REMINDER_TEMPLATE_LANG=en
